// ============================================
// MUNICIPALITIES & QUARTERS (CÃ´te d'Ivoire)
// ============================================
// Every City has at least one Municipality. For large cities (Abidjan) there
// are multiple (e.g. Cocody, Yopougon). For single-commune cities a single
// pass-through record with isPassThrough=true is seeded so queries are
// uniform and the frontend can skip the municipality dropdown.

model Municipality {
  id       String    @id @default(cuid())
  cityId   String
  city     City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name     String    // e.g. "Cocody", "Yopougon", "Toumodi"
  nameEn   String?
  isActive Boolean   @default(true)
  /// True when this is the only municipality for its city; frontend skips the dropdown
  isPassThrough Boolean @default(false)

  // Coordinates & geometry (PostGIS). geometry is the sous-prÃ©fecture/commune polygon.
  latitude  Float?
  longitude Float?
  geometry  Unsupported("geometry")?
  pcode     String? // External admin code (e.g. "CI200101") for idempotent import
  source    String? // "OSM" | "GADM" | "OFFICIAL" | "CURATED"

  quarters  Quarter[]
  locations CompanyLocation[]

  @@unique([cityId, name])
  @@index([cityId])
  @@map("municipality")
}

model Quarter {
  id             String       @id @default(cuid())
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  name           String       // e.g. "Riviera 3", "Zone 4", "Gare UTB"
  nameEn         String?
  isActive       Boolean      @default(true)

  // Coordinates & geometry (PostGIS). geometry is a point or small polygon where available.
  latitude   Float?
  longitude  Float?
  geometry   Unsupported("geometry")?
  externalId String? // OSM id or external reference for idempotent import
  source     String? // "OSM" | "GADM" | "OFFICIAL" | "CURATED"

  locations CompanyLocation[]

  @@unique([municipalityId, name])
  @@index([municipalityId])
  @@map("quarter")
}

// ============================================
// COMPANY LOCATION (extended â€” terminal promotion)
// ============================================
// CompanyLocation already holds operator depots from onboarding.
// Adding cityId FK + isTerminal flag promotes a location to a
// bookable passenger terminal without a separate model.

model CompanyLocation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("CompanyLocations", fields: [companyId], references: [id], onDelete: Cascade)

  // Link to canonical CI city
  cityId       String?
  cityRelation City?   @relation(fields: [cityId], references: [id])

  // Municipality & Quarter (CÃ´te d'Ivoire hierarchy)
  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])
  quarterId      String?
  quarter        Quarter?     @relation(fields: [quarterId], references: [id])

  // Terminal promotion â€” operator checks this in the dashboard
  isTerminal Boolean @default(false)

  // Geo-capture lifecycle (GPS capture link). COMPLETE = bookable/searchable.
  geoCaptureStatus LocationGeoCaptureStatus @default(COMPLETE)
  captureToken     String?                   @unique
  captureExpiresAt DateTime?

  // Location Details
  name         String
  addressLine1 String
  addressLine2 String?
  city         String? // Keep the original field name as optional to avoid data loss warning
  state        String?
  postalCode   String?
  country      String  @default("Cote d'Ivoire")
  latitude     Float?
  longitude    Float?

  // Contact
  phone        String
  managerName  String?
  managerPhone String?
  managerEmail String?

  // Operational
  isPrimary      Boolean @default(false)
  operatingHours Json?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Route relations
  originRoutes Route[]         @relation("RouteOriginTerminal")
  destRoutes   Route[]         @relation("RouteDestTerminal")
  waypoints    RouteWaypoint[]
  tripStops    TripStop[]
  captures     LocationCapture[]

  @@index([companyId])
  @@index([cityId])
  @@index([isTerminal])
  @@index([isPrimary])
  @@unique([companyId, name])
  @@map("company_location")
}

// Capture-link attempts + audit trail for a CompanyLocation. Each attempt mints
// a single-use, expiring token; GPS + resolved place are stored for operator
// approval before the terminal becomes geo-complete (COMPLETE).
model LocationCapture {
  id         String            @id @default(cuid())
  locationId String
  location   CompanyLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  token     String                 @unique
  expiresAt DateTime
  status    LocationCaptureStatus  @default(OPEN)

  // GPS point submitted by the share-page recipient
  latitude       Float?
  longitude      Float?
  accuracyMeters Int?
  capturedAt     DateTime?
  device         String?
  userAgent      String?
  ip             String?

  // Place resolved from the GPS point by the geo engine (awaits operator approval)
  resolvedCityId       String?
  resolvedMunicipalityId String?
  resolvedQuarterId    String?

  // Street address reverse-geocoded from the GPS point (Nominatim). Optional:
  // falls back to the hierarchy label on approve when absent.
  reverseGeocodedAddress String?

  // Submitter details editable on the share page (enriches address)
  submitterName  String?
  submitterPhone String?
  notes          String?

  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([locationId])
  @@index([token])
  @@index([status])
  @@map("location_capture")
}

// ============================================
// FLEET â€” BUS TYPE & SEAT LAYOUT TEMPLATES
// ============================================

model BusType {
  id          String  @id @default(cuid())
  name        String // "Toyota Coaster", "Yutong ZK6107", "Mercedes Sprinter"
  description String?
  isActive    Boolean @default(true)

  // null = platform default; set = operator custom type
  companyId String?
  company   Company? @relation("CompanyBusTypes", fields: [companyId], references: [id])

  layoutTemplates SeatLayoutTemplate[]
  buses           Bus[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("bus_type")
}

model SeatLayoutTemplate {
  id        String  @id @default(cuid())
  busTypeId String
  busType   BusType @relation(fields: [busTypeId], references: [id])

  // null = platform default; set = operator custom layout
  companyId String?
  company   Company? @relation("CompanyLayoutTemplates", fields: [companyId], references: [id])

  name       String    // "Coaster Standard 22", "Coach VIP 18", "Coach 2+2 45"
  seatClass  SeatClass @default(STANDARD)
  totalSeats Int
  rows       Int
  columns    Int
  hasAC      Boolean   @default(false)
  hasWifi    Boolean   @default(false)
  hasToilet  Boolean   @default(false)
  hasLuggage Boolean   @default(true)

  seatTemplates SeatTemplate[]
  buses         Bus[]

  @@index([busTypeId])
  @@index([companyId])
  @@map("seat_layout_template")
}

model SeatTemplate {
  id       String             @id @default(cuid())
  layoutId String
  layout   SeatLayoutTemplate @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  row        Int
  col        Int
  deck       Int      @default(1)
  label      String // "1A", "1B", "2A" â€” shown to operators and passengers
  seatType   SeatType @default(PASSENGER_WINDOW)
  isBookable Boolean  @default(true)

  @@index([layoutId])
  @@map("seat_template")
}

// ============================================
// FLEET â€” BUS & SEATS
// ============================================

model Bus {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  busTypeId        String
  busType          BusType            @relation(fields: [busTypeId], references: [id])
  layoutTemplateId String
  layoutTemplate   SeatLayoutTemplate @relation(fields: [layoutTemplateId], references: [id])

  registrationPlate String    @unique
  internalName      String? // "Bus Alpha", operator's own reference
  seatClass         SeatClass @default(STANDARD)
  manufactureYear   Int?
  status            BusStatus @default(ACTIVE)
  notes             String?

  seats Seat[]
  trips Trip[]
  preferredForSchedules Schedule[] @relation("SchedulePreferredBus")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([status])
  @@map("bus")
}

model Seat {
  id    String @id @default(cuid())
  busId String
  bus   Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)

  row      Int
  col      Int
  deck     Int      @default(1)
  label    String // "1A", "2B" â€” copied from SeatTemplate, operator can rename
  seatType   SeatType
  isBookable Boolean  @default(true) // immutable: copied from SeatTemplate.isBookable
  isActive   Boolean  @default(true) // false = operator disabled (broken/damaged)

  tripSeats TripSeat[]
  bookings  Booking[]

  @@index([busId])
  @@index([busId, deck, row, col])
  @@map("seat")
}

// ============================================
// ROUTES & WAYPOINTS
// ============================================

model Route {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String // "Abidjan â€“ BouakÃ© Express"

  originTerminalId String
  originTerminal   CompanyLocation @relation("RouteOriginTerminal", fields: [originTerminalId], references: [id])

  destTerminalId String
  destTerminal   CompanyLocation @relation("RouteDestTerminal", fields: [destTerminalId], references: [id])

  distanceKm Float?

  /// INTERCITY = terminals in different cities; URBAN = same city.
  /// Derived server-side from terminal cityIds at create/update.
  serviceType ServiceType @default(INTERCITY)

  status RouteStatus @default(DRAFT)

  waypoints RouteWaypoint[]
  schedules Schedule[]
  campaignScopes CampaignRouteScope[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([serviceType])
  @@index([originTerminalId])
  @@index([destTerminalId])
  @@unique([companyId, name])
  @@map("route")
}

model RouteWaypoint {
  id         String          @id @default(cuid())
  routeId    String
  route      Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  terminalId String
  terminal   CompanyLocation @relation(fields: [terminalId], references: [id])

  stopOrder            Int // 0 = origin, 1..N-1 = intermediate, N = destination
  distanceFromOriginKm Float?
  isPickup             Boolean @default(true) // passengers can board here
  isDropoff            Boolean @default(true) // passengers can alight here

  scheduleWaypoints ScheduleWaypoint[] @relation("WaypointScheduleTiming")

  @@unique([routeId, stopOrder])
  @@index([routeId])
  @@index([terminalId])
  @@map("route_waypoint")
}

// ============================================
// SCHEDULES â€” TEMPLATES + CALENDAR
// ============================================

model Schedule {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route   @relation(fields: [routeId], references: [id])

  name          String? // "Morning Express", "Night Service"
  // Primary departure time "06:00" â€” HH:mm, CI timezone is UTC+0 (no DST).
  // Kept as the first element of departureTimes for sorting/back-compat.
  departureTime  String @db.VarChar(5)
  // Full cadence: every departure time the schedule runs, sorted HH:mm.
  // Empty for legacy rows until backfilled (then falls back to [departureTime]).
  departureTimes String[] @default([])
  isActive      Boolean @default(true)

  // Total estimated duration - can differ per schedule based on traffic/time
  estimatedMinutes Int?

  // Preferred bus for trip generation only â€” trips remain per-trip assignable
  preferredBusId String?
  preferredBus   Bus?    @relation("SchedulePreferredBus", fields: [preferredBusId], references: [id], onDelete: SetNull)

  calendar   ServiceCalendar?
  exceptions ServiceException[]
  fares      Fare[]
  trips      Trip[]

  // Schedule-specific timing - decouples from route level
  scheduleWaypoints ScheduleWaypoint[]
  campaignScopes    CampaignScheduleScope[]
  monetaryVouchers  MonetaryVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([routeId])
  @@index([isActive])
  @@index([preferredBusId])
  @@map("schedule")
}

model ServiceCalendar {
  id         String   @id @default(cuid())
  scheduleId String   @unique
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  monday    Boolean @default(false)
  tuesday   Boolean @default(false)
  wednesday Boolean @default(false)
  thursday  Boolean @default(false)
  friday    Boolean @default(false)
  saturday  Boolean @default(false)
  sunday    Boolean @default(false)

  validFrom  DateTime
  validUntil DateTime? // null = runs indefinitely

  @@map("service_calendar")
}

model ServiceException {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  date   DateTime // the specific date affected (date only, time ignored)
  type   ExceptionType
  reason ExceptionReason @default(OPERATIONAL)
  notes  String?
  /// HH:mm override used when type === MODIFIED
  overrideDepartureTime String? @db.VarChar(5)

  @@index([scheduleId])
  @@index([date])
  @@unique([scheduleId, date])
  @@map("service_exception")
}

// ============================================
// SCHEDULE TIMING (per-schedule duration)
// ============================================

model ScheduleWaypoint {
  id         String @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Reference to route waypoint for terminal/segment data
  routeWaypointId String
  routeWaypoint   RouteWaypoint @relation("WaypointScheduleTiming", fields: [routeWaypointId], references: [id])

  // Timing offsets from origin departure (minutes)
  arrivalOffsetMinutes   Int
  departureOffsetMinutes Int

  // Optional dwell time override
  dwellMinutes Int?

  @@unique([scheduleId, routeWaypointId])
  @@index([scheduleId])
  @@map("schedule_waypoint")
}

// ============================================
// FARES (extensible from v1)
// ============================================

model Fare {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  type      FareType  @default(FIXED)

  // Which segment this price covers (by waypoint stopOrder indices)
  // 0 â†’ N = full route. 2 â†’ N = board at intermediate stop 2.
  fromStopOrder Int @default(0)
  toStopOrder   Int

  durationMinutes Int // travel time from departure at fromStop to arrival at toStop
  priceXOF   Int // price in CFA Francs â€” always XOF for CI
  validFrom  DateTime?
  validUntil DateTime?
  isActive   Boolean   @default(true)

  @@index([scheduleId])
  @@index([scheduleId, fromStopOrder, toStopOrder])
  @@index([type])
  @@map("fare")
}

// ============================================
// TRIPS â€” THE OPERATIONAL ENTITY
// ============================================

model Trip {
  id         String    @id @default(cuid())
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])

  // Bus assigned PER TRIP â€” not per schedule (maintenance/swap support)
  busId String
  bus   Bus    @relation(fields: [busId], references: [id])

  // Schedule-derived but stored immutably on trip creation
  departureDate DateTime // full timestamp: 2025-08-15T06:00:00Z

  // Snapshot of the route's service type at generation â€” search filters on
  // this instead of re-deriving from terminal geometry
  serviceType ServiceType @default(INTERCITY)

  // Operational tracking
  estimatedArrival DateTime?
  actualDeparture  DateTime?
  actualArrival    DateTime?
  delayMinutes     Int?
  gate             String? // physical bay/gate at origin terminal
  status           TripStatus @default(SCHEDULED)
  cancelReason     String?
  notes            String?

  // Route snapshot frozen at trip creation â€” protects historical bookings
  // if the route is later edited or deleted
  routeSnapshotJson Json

  totalSeats Int

  // Set when a schedule is deleted but the trip still has booking history
  archivedAt DateTime?

  tripStops  TripStop[]
  seats      TripSeat[]
  bookings   Booking[]
  holdGroups HoldGroup[]
  campaignScopes CampaignTripScope[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([scheduleId])
  @@index([busId])
  @@index([status])
  @@index([serviceType])
  @@index([departureDate])
  @@unique([scheduleId, departureDate])
  @@map("trip")
}

// TripStops â€” instantiated from RouteWaypoints when a trip is created.
// Search queries these for intermediate boarding (Daloa â†’ Man on an Abidjan â†’ Man bus).

model TripStop {
  id         String          @id @default(cuid())
  tripId     String
  trip       Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  terminalId String
  terminal   CompanyLocation @relation(fields: [terminalId], references: [id])

  stopOrder          Int
  scheduledArrival   DateTime? // computed from departureDate + arrivalOffset
  scheduledDeparture DateTime? // computed from departureDate + departureOffset
  actualArrival      DateTime?
  actualDeparture    DateTime?
  isPickup           Boolean   @default(true)
  isDropoff          Boolean   @default(true)

  originBookings      Booking[] @relation("BookingOriginStop")
  destinationBookings Booking[] @relation("BookingDestStop")

  @@unique([tripId, stopOrder])
  @@index([tripId])
  @@index([terminalId])
  @@index([tripId, isPickup, scheduledDeparture])
  @@index([tripId, isDropoff])
  @@map("trip_stop")
}

model TripSeat {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seatId String
  seat   Seat   @relation(fields: [seatId], references: [id])

  // Marks whether the seat is usable for THIS trip (false = operator blocked this
  // seat per-trip, or inherited from Seat.isActive at trip creation).
  // Availability for booking is derived from booking overlap at query time.
  isActive      Boolean @default(true)
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, seatId])
  @@index([tripId])
  @@index([tripId, isActive])
  @@index([tripId, isActive, seatId])
  @@map("trip_seat")
}

// ============================================
// CHECKOUT & PAYMENTS
// ============================================

model PlatformSettings {
  id String @id @default("default")

  defaultCommissionBps      Int @default(500)
  defaultConvenienceFeeBps  Int @default(250)
  paystackFeeLocalCardBps   Int @default(320)
  paystackFeeIntlCardBps    Int @default(380)
  paystackFeeMobileMoneyBps Int @default(195)

  minWithdrawalAmount      Int @default(5000)
  withdrawalFrequencyHours Int @default(24)

  require2FAForWithdrawals Boolean @default(false)

  /** Max active promotional vouchers per traveler (excl. cancel/mod). */
  maxPromotionalVouchersPerUser Int @default(3)

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}


model PlatformSettingsAudit {
  id            String   @id @default(cuid())
  settingKey    String
  oldValue      Json?
  newValue      Json
  changedById   String
  changedByUser User     @relation("PlatformSettingsAuditChangedBy", fields: [changedById], references: [id])
  changeReason  String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([settingKey])
  @@index([changedById])
  @@map("platform_settings_audit")
}


model CommissionDistanceTier {
  id            String  @id @default(cuid())
  label         String
  minDistanceKm Float
  maxDistanceKm Float?
  commissionBps Int
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("commission_distance_tier")
}

model HoldGroup {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  offerId       String
  status        HoldGroupStatus @default(ACTIVE)
  holdExpiresAt DateTime
  seatCount     Int
  baseFareXOF   Int // per seat, tax-inclusive

  bookings            Booking[]
  pricingSnapshot     PricingSnapshot?
  payment             ExternalPayment?
  refunds             Refund[]
  discountRedemptions DiscountRedemption[]
  vouchersIssued      MonetaryVoucher[]    @relation("VoucherSourceHoldGroup")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([tripId])
  @@index([userId])
  @@index([status, holdExpiresAt])
  @@map("hold_group")
}

model PricingSnapshot {
  id          String    @id @default(cuid())
  holdGroupId String    @unique
  holdGroup   HoldGroup @relation(fields: [holdGroupId], references: [id], onDelete: Cascade)

  distanceKm        Float?
  commissionBps     Int
  convenienceFeeBps Int
  baseFareXOF       Int
  seatCount         Int
  subtotalBaseXOF   Int
  convenienceFeeXOF Int
  chargeAmountXOF   Int
  commissionXOF     Int
  operatorNetXOF    Int
  platformGrossXOF  Int
  snapshotJson      Json?

  // Discount / voucher / credit freeze (null pre* = legacy pre-discount system)
  ticketDiscountXOF       Int  @default(0)
  feeDiscountXOF          Int  @default(0)
  creditAppliedXOF        Int  @default(0)
  preDiscountSubtotalXOF  Int?
  postDiscountSubtotalXOF Int?
  platformPromoFundedXOF  Int  @default(0)
  operatorPromoFundedXOF  Int  @default(0)
  discountBreakdownJson   Json?

  createdAt DateTime @default(now())

  @@map("pricing_snapshot")
}

model ExternalPayment {
  id          String     @id @default(cuid())
  holdGroupId String?    @unique
  /// Restrict: do not hard-delete hold after payment money moved (P2-15).
  holdGroup   HoldGroup? @relation(fields: [holdGroupId], references: [id], onDelete: Restrict)

  provider          String
  amountXOF         Int
  status            PaymentRecordStatus @default(INITIALIZED)
  /// Discriminates checkout vs wallet top-up (replaces metadata.isTopUp for new rows).
  purpose           PaymentPurpose      @default(CHECKOUT)
  paystackReference String?             @unique
  channel           String?
  feesXOF           Int?
  metadata          Json?
  confirmedAt       DateTime?

  attempts     PaymentAttempt[]
  events       PaymentEvent[]
  refunds      Refund[]
  transactions FinancialTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paystackReference])
  @@index([purpose])
  @@map("payment")
}

model PaymentAttempt {
  id                String              @id @default(cuid())
  paymentId         String
  payment           ExternalPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  paystackReference String              @unique
  status            PaymentRecordStatus @default(INITIALIZED)
  channel           String?
  failureReason     String?
  metadata          Json?

  createdAt DateTime @default(now())

  @@unique([paymentId, attemptNumber])
  @@index([paymentId])
  @@map("payment_attempt")
}

model PaymentEvent {
  id        String          @id @default(cuid())
  paymentId String
  payment   ExternalPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType String
  payload   Json
  createdAt DateTime        @default(now())

  @@index([paymentId])
  @@map("payment_event")
}

model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventType      String
  idempotencyKey String    @unique
  reference      String?
  payload        Json
  processedAt    DateTime?
  error          String?

  createdAt DateTime @default(now())

  @@index([provider, createdAt])
  @@map("webhook_event")
}

model Refund {
  id          String    @id @default(cuid())
  holdGroupId String
  /// Restrict: do not hard-delete hold after refund rows exist (P2-15).
  holdGroup   HoldGroup @relation(fields: [holdGroupId], references: [id], onDelete: Restrict)

  /// Seat-level cancel target (required for new refunds).
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// Null for wallet / zero-cash confirms that never created ExternalPayment.
  paymentId String?
  payment   ExternalPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  amountXOF             Int
  channel               RefundChannel
  status                RefundRecordStatus @default(PENDING)
  paystackRefundId      String?            @unique
  requestIdempotencyKey String?            @unique
  reason                String?

  /// Offline fulfilment (CASH/VOUCHER PENDING_FULFILMENT → COMPLETED/VOIDED).
  fulfilledAt       DateTime?
  fulfilledByUserId String?
  voidedAt          DateTime?
  voidedByUserId   String?
  fulfilmentNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([holdGroupId])
  @@index([paymentId])
  @@index([bookingId])
  @@index([status, createdAt])
  @@map("refund")
}

// ============================================
// FINANCIAL CORE (DOUBLE-ENTRY LEDGER)
// ============================================

model FinancialAccount {
  id String @id @default(cuid())

  // Generic Ownership (Allows multiple accounts per owner)
  ownerType AccountOwnerType
  ownerId   String // e.g., userId or companyId

  accountCategory      AccountCategory
  accountClass         String // e.g., "PASSENGER_WALLET", "OPERATOR_RECEIVABLE", "LOYALTY_POINTS" (Data-driven)
  currency             String          @default("XOF")
  status               AccountStatus   @default(NORMAL)
  allowNegativeBalance Boolean         @default(false)

  // âš ï¸ READ MODEL: Derived Cache. Mutated EXCLUSIVELY by AccountingEngine
  postedBalance    BigInt @default(0) // Total settled
  reservedBalance  BigInt @default(0) // Locked in reservations
  availableBalance BigInt @default(0) // posted - reserved

  ledgerEntries LedgerEntry[]
  reservations  WalletReservation[]
  snapshots     FinancialAccountSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerType, ownerId, accountCategory, accountClass, currency])
  @@index([ownerType, ownerId])
  @@map("financial_account")
}

model FinancialAccountSnapshot {
  id        String           @id @default(cuid())
  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id])

  period           String // "DAILY", "WEEKLY", "MONTHLY"
  snapshotDate     DateTime
  postedBalance    BigInt
  reservedBalance  BigInt
  availableBalance BigInt

  createdAt DateTime @default(now())

  @@unique([accountId, period, snapshotDate])
  @@map("financial_account_snapshot")
}

model FinancialTransaction {
  id     String            @id @default(cuid())
  type   String // Business Event: e.g., "BOOKING", "TOP_UP", "REFUND"
  status TransactionStatus @default(CREATED)

  // Explicit infrastructure linkage
  externalPaymentId String?
  externalPayment   ExternalPayment? @relation(fields: [externalPaymentId], references: [id])

  /// App-level idempotency (e.g. REFUND_WALLET_{bookingId}). Replaces unique(externalPaymentId, type)
  /// so multi-seat refunds against one Paystack payment are allowed.
  businessIdempotencyKey String? @unique

  currency    String  @default("XOF")
  description String?
  metadata    Json?

  entries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalPaymentId, type])
  @@map("financial_transaction")
}

model LedgerEntry {
  id            String               @id @default(cuid())
  transactionId String
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id])

  side     LedgerEntrySide
  amount   BigInt
  currency String            @default("XOF")
  status   LedgerEntryStatus @default(POSTED)

  sequenceNumber Int
  description    String?
  referenceType  String? // e.g., "BOOKING_ID"
  referenceId    String?
  effectiveAt    DateTime @default(now())
  idempotencyKey String   @unique

  createdAt DateTime @default(now())

  @@unique([transactionId, sequenceNumber])
  @@map("ledger_entry")
}

model WalletReservation {
  id        String           @id @default(cuid())
  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id])

  holdGroupId String?

  amount    Int
  currency  String            @default("XOF")
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  releasedAt DateTime? // null until the reserved balance is released back to available; claim guard for the release-reservations cron (exactly-once + crash recovery)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([holdGroupId])
  @@map("wallet_reservation")
}

model SettlementPolicy {
  id              String  @id @default(cuid())
  name            String
  type            String // "TIME_BASED", "THRESHOLD_BASED", "MANUAL"
  isDefault       Boolean @default(false)
  isActive        Boolean @default(true)
  priority        Int     @default(0)
  thresholdAmount Int?
  cronSchedule    String?

  companies Company[]

  @@map("settlement_policy")
}

// ============================================
// BOOKINGS
// ============================================

model Booking {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  seatId    String
  seat      Seat    @relation(fields: [seatId], references: [id])

  // Segment relations
  originTripStopId      String
  originTripStop        TripStop @relation("BookingOriginStop", fields: [originTripStopId], references: [id])
  destinationTripStopId String
  destinationTripStop   TripStop @relation("BookingDestStop", fields: [destinationTripStopId], references: [id])
  boardingStopOrder     Int
  dropoffStopOrder      Int

  // Holding & Reservation
  status        BookingStatus @default(PENDING_PAYMENT)
  holdExpiresAt DateTime? // Null for confirmed bookings; set for holds
  issuedAt      DateTime? // When the ticket was actually issued (after payment)

  // Booking details
  farePaid         Int // price paid in XOF
  paymentStatus    PaymentStatus @default(UNPAID)
  bookingReference String        @unique // e.g. MR-7K4P92
  passengerName    String
  passengerPhone   String
  ticketToken      String        @unique @default(cuid()) // used to generate QR code dynamically

  // Multi-seat checkout grouping
  holdGroupId      String?
  holdGroup        HoldGroup?      @relation(fields: [holdGroupId], references: [id], onDelete: SetNull)
  savedPassengerId String?
  savedPassenger   SavedPassenger? @relation(fields: [savedPassengerId], references: [id], onDelete: SetNull)

  // Review relation
  review Review?

  // Vouchers issued from this booking (cancel / modification)
  vouchersIssued MonetaryVoucher[] @relation("VoucherSourceBooking")
  refunds        Refund[]

  // Tracking
  checkedInAt DateTime?
  boardedAt   DateTime?
  completedAt DateTime?
  clearedAt   DateTime? // Escrow clearance (when funds become available for withdrawal)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([tripId, seatId, status])
  @@index([tripId, status])
  @@index([tripId, status, holdExpiresAt])
  @@index([tripId, seatId, originTripStopId, destinationTripStopId])
  @@index([userId])
  @@index([holdGroupId])
  @@map("booking")
}

// Expanded from stub in Phase 4
model Review {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  rating   Int
  content  String?
  authorId String
  author   User    @relation(fields: [authorId], references: [id])

  // Operator's public response to the passenger's review (L11).
  response    String?   @db.Text
  respondedAt DateTime?

  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("review")
}

model PassengerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketingOptIn   Boolean @default(false)
  preferencesJson  Json?
  stripeCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedPassengers SavedPassenger[]

  @@map("passenger_profile")
}

model SavedPassenger {
  id        String           @id @default(cuid())
  profileId String
  profile   PassengerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  fullName    String
  phone       String
  email       String?
  label       String?
  dateOfBirth DateTime?
  idType      String?
  idNumber    String?
  isSelf      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([profileId])
  @@map("saved_passenger")
}

model StaffInvitation {
  id           String           @id @default(cuid())
  email        String
  role         StaffRole        @default(OPERATIONS)
  /// Snapshot of IAM actions granted at invite time; copied onto Operator on accept.
  permissions  String[]         @default([])
  jobTitle     String?
