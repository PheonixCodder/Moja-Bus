// ============================================
// AUTHENTICATION MODELS (Existing)
// ============================================

model User {
  id            String   @id
  fullName      String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  phoneNumber           String?  @unique
  phoneNumberVerified   Boolean  @default(false)
  role                  UserRole @default(TRAVELER)

  // Operator registration fields
  workEmail String? @unique
  workPhone String? @unique

  passwordHash String?
  twoFactorEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sessions         Session[]
  accounts         Account[]
  refreshTokens    RefreshToken[]
  operatorProfiles Operator[]
  passengerProfile PassengerProfile?

  // Admin verification actions performed by this user
  verificationsPerformed       CompanyDocument[]     @relation("DocumentReviewedBy")
  companiesVerified            Company[]             @relation("CompanyVerifiedBy")
  bankAccountsVerified         BankAccount[]         @relation("BankAccountVerifiedBy")
  companyVerificationsReviewed CompanyVerification[] @relation("CompanyVerificationReviewer")
  platformSettingsAudits PlatformSettingsAudit[] @relation("PlatformSettingsAuditChangedBy")

  // Staff & Activity relations
  sentInvitations     StaffInvitation[] @relation("InvitedBy")
  acceptedInvitations StaffInvitation[] @relation("AcceptedBy")
  activityLogs        ActivityLog[]
  bankAccessLogs      BankAccessLog[]

  // Admin Staff relations
  adminStaff          AdminStaff?
  sentAdminInvitations AdminStaffInvitation[] @relation("AdminInvitationsSent")
  acceptedAdminInvitations AdminStaffInvitation[] @relation("AdminInvitationsAccepted")
  adminStaffActivityLogs AdminStaffActivityLog[]

  bookings   Booking[]
  holdGroups HoldGroup[]
  reviews    Review[]

  // Blog system relations
  authoredBlogs BlogPost[]     @relation("BlogAuthor")
  reviewedBlogs BlogPost[]     @relation("BlogReviewer")
  blogRevisions BlogRevision[] @relation("BlogRevisionAuthor")

  // Contact inquiries submitted while logged in
  contactInquiries ContactInquiry[] @relation("ContactInquiryAuthor")
  resolvedInquiries ContactInquiry[] @relation("ContactInquiryResolvedBy")

  // Discounts / vouchers / referrals
  discountCampaignsCreated DiscountCampaign[] @relation("DiscountCampaignCreatedBy")
  assignedCouponCodes      CouponCode[]       @relation("CouponCodeAssignedUser")
  monetaryVouchers         MonetaryVoucher[]  @relation("MonetaryVoucherOwner")
  vouchersIssuedAsAdmin    MonetaryVoucher[]  @relation("MonetaryVoucherIssuedBy")
  creditLots               CreditLot[]
  referralCode             ReferralCode?
  referralEdgesAsReferrer  ReferralEdge[]     @relation("ReferralReferrer")
  referralEdgesAsReferee   ReferralEdge[]     @relation("ReferralReferee")
  discountRedemptions      DiscountRedemption[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Self-contained 2FA gate for operator withdrawals (F-18). Stores a hashed
// one-time withdrawal confirmation code, fully isolated from Better Auth.
model WithdrawalTwoFactorChallenge {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  email      String
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("withdrawal_2fa_challenge")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// OPERATOR REGISTRATION MODELS
// ============================================

model Company {
  id                 String       @id @default(cuid())
  name               String
  slug               String       @unique
  email              String       @unique
  phone              String       @unique
  website            String?
  description        String?
  businessType       BusinessType @default(SOLE_PROPRIETORSHIP)
  registrationNumber String       @unique
  taxId              String       @unique
  yearEstablished    Int?
  logoUrl            String?
  estimatedStaffSize Int

  // Status & Verification
  status          CompanyStatus @default(DRAFT)
  verifiedAt      DateTime?
  // Proper FK relation â€” no free-text admin ID string
  verifiedById    String?
  verifiedBy      User?         @relation("CompanyVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  // Legal acceptance timestamps + version tracking
  termsAcceptedAt      DateTime?
  commissionAcceptedAt DateTime?
  privacyAcceptedAt    DateTime?
  termsVersion         String?
  privacyVersion       String?
  commissionVersion    String?

  // Relations
  locations      CompanyLocation[]    @relation("CompanyLocations")
  documents      CompanyDocument[]
  bankAccounts   BankAccount[]
  operators      Operator[]
  invitations    StaffInvitation[]
  activityLogs   ActivityLog[]
  bankAccessLogs BankAccessLog[]
  withdrawalTwoFactorChallenges WithdrawalTwoFactorChallenge[]
  verification   CompanyVerification?

  // Fleet & Operations
  fleet           Bus[]
  busTypes        BusType[] @relation("CompanyBusTypes")
  layoutTemplates SeatLayoutTemplate[] @relation("CompanyLayoutTemplates")
  routes          Route[]
  schedules       Schedule[]
  trips           Trip[]
  bookings        Booking[]
  reviews         Review[]
  holdGroups      HoldGroup[]
  discountCampaigns DiscountCampaign[]
  campaignOptIns    CampaignCompanyOptIn[]
  discountRedemptions DiscountRedemption[]
  monetaryVouchers  MonetaryVoucher[]

  // Paystack transfer recipient for manual settlements
  paystackTransferRecipientCode String?

  settlementPolicyId String?
  settlementPolicy   SettlementPolicy? @relation(fields: [settlementPolicyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([registrationNumber])
  @@index([taxId])
  @@map("company")
}

// CompanyLocation is defined further below with full terminal + city support

model CompanyDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Document Details
  type     DocumentType
  fileName String
  fileUrl  String // S3/Cloudflare URL (empty for private docs served via signed GET)
  objectKey String? // S3 object key â€” authoritative for private documents
  fileSize Int // Bytes
  mimeType String // application/pdf, image/jpeg, etc.

  // Verification â€” proper FK to User
  status       DocumentStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?          @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  notes        String?

  // Expiry (for permits, insurance)
  expiresAt      DateTime?
  reminderSentAt DateTime?

  // Versioning â€” new upload supersedes old; old document retained for audit
  isCurrent    Boolean           @default(true)
  supersededAt DateTime?
  replacedById String?
  replacedBy   CompanyDocument?  @relation("DocumentReplacement", fields: [replacedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replaces     CompanyDocument[] @relation("DocumentReplacement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([isCurrent])
  @@map("company_document")
}

model BankAccount {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Bank Details
  bankName           String
  bankCode           String?
  // Encrypted at rest (enc:v1: prefix) â€” see apps/web/lib/bank-crypto.ts
  accountNumber      String
  accountNumberLast4 String?
  accountName        String // Must match company name
  branch             String?
  swiftCode          String?
  iban               String?

  // Verification â€” proper FK to User
  isVerified             Boolean   @default(false)
  verifiedAt             DateTime?
  verifiedById           String?
  verifiedBy             User?     @relation("BankAccountVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationDocumentId String? // Link to CompanyDocument

  // Status
  isActive                      Boolean @default(true)
  isDefault                     Boolean @default(false)
  paystackTransferRecipientCode String?

  // External verification metadata
  verificationProvider  String? // e.g. "PAYSTACK", "FLUTTERWAVE"
  verifiedByProvider    Boolean   @default(false)
  verificationReference String?
  verificationPayload   Json?
  lastVerificationAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bankName, accountNumber])
  @@index([companyId])
  @@map("bank_account")
}

model BankAccessLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ip        String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@map("bank_access_log")
}

model CompanyVerification {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ownerIdentityVerified Boolean @default(false)
  bankVerified          Boolean @default(false)
  documentsVerified     Boolean @default(false)
  permitVerified        Boolean @default(false)

  reviewedById String?
  reviewedBy   User?     @relation("CompanyVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  @@map("company_verification")
}

model Operator {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Company Link
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Role & Status
  // permissions[] is the authoritative IAM action set (see @moja/schemas permissions).
  // OWNER bypasses checks at runtime â€” stored set may be empty for owners.
  permissions            String[]  @default([])
  permissionsUpdatedAt   DateTime?
  permissionsUpdatedBy   String?
  role       StaffRole      @default(OWNER)
  status     OperatorStatus @default(ACTIVE)
  isActive   Boolean        @default(true)
  isVerified Boolean        @default(false)
  deletedAt  DateTime?

  // Onboarding status and tracking
  onboardingStatus   OnboardingStatus          @default(NOT_STARTED)
  onboardingProgress OperatorOnboarding?
  onboardingEvents   OperatorOnboardingEvent[]

  // Personal Details
  dateOfBirth          DateTime?
  nationalIdNumber     String?
  nationalIdType       String? // passport | national_id | driver_license
  nationalIdDocumentId String? // Link to CompanyDocument

  // Contact
  personalPhone         String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Profile
  profilePhotoUrl String?
  jobTitle        String?

  // Timestamps
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@index([role])
  @@map("operator")
}

// ============================================
// OPERATOR ONBOARDING PROGRESS
// ============================================

model OperatorOnboarding {
  id         String   @id @default(cuid())
  operatorId String   @unique
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  currentStep        OnboardingStep @default(COMPANY)
  completedSteps     Json           @default("[]")
  completedStepCount Int            @default(0)
  totalSteps         Int            @default(5)

  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
