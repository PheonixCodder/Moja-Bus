// ============================================
// GEO CAPTURE ENUMS (Terminal link capture)
// ============================================

/// Lifecycle of a terminal's geography. COMPLETE = fully geo-linked and bookable.
enum LocationGeoCaptureStatus {
  COMPLETE
  PENDING_CAPTURE // operator created bare terminal, awaiting a shared capture link
  PENDING_CONFIRMATION // GPS captured + resolved, waiting for operator approval
}

/// Lifecycle of a single capture-link attempt.
/// OPEN → PENDING_CONFIRMATION (submit) → CONFIRMED (submitter confirms preview)
/// → APPROVED (operator approveCapture flips the terminal to COMPLETE). rejectCapture/expiry
/// terminate the attempt without making the terminal geo-complete.
enum LocationCaptureStatus {
  OPEN // link minted, not yet opened
  PENDING_CONFIRMATION // GPS submitted + place resolved, awaiting submitter confirmation
  CONFIRMED // submitter confirmed the resolved preview; awaiting operator approval
  APPROVED // operator approved; terminal COMPLETE and geo-linked
  REJECTED // operator rejected; terminal back to PENDING_CAPTURE
  EXPIRED // TTL elapsed before completion
}

