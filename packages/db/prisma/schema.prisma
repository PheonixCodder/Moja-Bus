  acceptedBy   User?            @relation("AcceptedBy", fields: [acceptedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([companyId])
  @@index([email])
  @@index([token])
  @@map("staff_invitation")
}

model ActivityLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  metadata     Json?
  targetUserId String?
  description String
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@map("activity_log")
}

enum OperatorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ============================================
// ENTERPRISE BLOG SYSTEM
// ============================================

enum BlogPostStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum BlogEventType {
  VIEW
  READ_25
  READ_50
  READ_75
  READ_100
  CTA_CLICK
  SHARE
}

model BlogCategory {
  id          String         @id @default(cuid())
  parentId    String?
  parent      BlogCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    BlogCategory[] @relation("CategoryHierarchy")
  name        String         @unique
  slug        String         @unique
  description String?
  posts       BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_category")
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]

  @@map("blog_tag")
}

model BlogPost {
  id     String         @id @default(cuid())
  status BlogPostStatus @default(DRAFT)

  title String
  slug  String @unique

  content String  @db.Text
  excerpt String? @db.Text

  // Author Display Overrides
  authorId            String
  author              User    @relation("BlogAuthor", fields: [authorId], references: [id])
  displayAuthorName   String?
  displayAuthorBio    String?
  displayAuthorAvatar String?

  // Images & Media
  coverImage       String?
  coverImageBlur   String?
  coverImageAlt    String?
  coverImageCredit String?
  ogImage          String?

  // Precomputed & Metadata
  readingTime Int    @default(0)
  wordCount   Int    @default(0)
  language    String @default("en")

  // Feature flags
  featured      Boolean @default(false)
  featuredOrder Int?
  allowIndex    Boolean @default(true)
  allowComments Boolean @default(false)

  // SEO Metadata
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  robots             String?
  ogTitle            String?
  ogDescription      String?
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?

  // Timestamps & Workflow
  scheduledFor     DateTime?
  publishedAt      DateTime?
  lastReviewedAt   DateTime?
  lastReviewedById String?
  reviewer         User?     @relation("BlogReviewer", fields: [lastReviewedById], references: [id])

  // Soft Delete
  deletedAt   DateTime?
  deletedById String?

  // Analytics Base
  viewCount      Int   @default(0)
  completionRate Float @default(0)

  // Relations
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       BlogTag[]

  revisions BlogRevision[]
  events    BlogEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("blog_post")
}

model BlogRevision {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  changedById String
  changedBy   User     @relation("BlogRevisionAuthor", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@map("blog_revision")
}

model BlogSlugHistory {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  newSlug   String
  createdAt DateTime @default(now())

  @@map("blog_slug_history")
}

model BlogRedirect {
  id          String   @id @default(cuid())
  source      String   @unique
  destination String
  type        Int      @default(301)
  createdAt   DateTime @default(now())

  @@map("blog_redirect")
}

model BlogEvent {
  id     String   @id @default(cuid())
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  eventType BlogEventType
  userId    String?
  sessionId String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([postId, eventType])
  @@index([createdAt])
  @@map("blog_event")
}

enum BannerActionType {
  SEARCH          // Pre-fills search parameters (origin, destination)
  APP_SCREEN      // Deep links to an app tab (search, bookings, tickets, settings)
  BLOG_ARTICLE    // Opens specific blog post by slug
  EXTERNAL_URL    // Opens external web URL
}

model PromoBanner {
  id             String           @id @default(cuid())
  title          String
  subtitle       String?
  badge          String?          // e.g. "15% OFF", "VIP", "PROMO"
  imageUrl       String
  actionType     BannerActionType @default(SEARCH)
  actionPayload  Json?            // e.g. { originSlug, destinationSlug } or { targetTab: "search" } or { slug: "..." }
  gradientColors String[]         // e.g. ["#ee237c", "#9333ea"]
  isActive       Boolean          @default(true)
  sortOrder      Int              @default(0)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([isActive, sortOrder])
  @@map("promo_banner")
}

// ============================================
// CONTACT & SUPPORT INQUIRIES
// ============================================
// Captures contact form submissions from the public website. `userId` is
// set server-side from the session when the submitter is logged in and
// remains null for guests.

model ContactInquiry {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String               @db.Text
  status    ContactInquiryStatus @default(NEW)

  // Author â€” set server-side from the session (null = logged-out guest)
  userId String?
  user   User? @relation("ContactInquiryAuthor", fields: [userId], references: [id], onDelete: SetNull)

  // Origin & audit
  ipAddress  String?
  userAgent  String?

  // Resolution workflow
  adminNote   String?   @db.Text
  resolvedById String?
  resolvedBy   User?     @relation("ContactInquiryResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([userId])
  @@map("contact_inquiry")
}

// ============================================
// DISCOUNTS / COUPONS / VOUCHERS / REFERRALS
// ============================================

model DiscountCampaign {
  id          String             @id @default(cuid())
  ownerType   CampaignOwnerType
  companyId   String?
  company     Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      CampaignStatus     @default(DRAFT)

  fundingType        CampaignFundingType @default(OPERATOR)
  platformShareBps   Int                 @default(0)
  operatorShareBps   Int                 @default(10000)

  benefitType    BenefitType
  percentBps     Int?
  amountXOF      Int?
  freeSeatCount  Int?
  applyTarget    DiscountApplyTarget @default(TICKET_ONLY)

  startsAt DateTime?
  endsAt   DateTime?

  minSubtotalXOF   Int?
  minSeatCount     Int?
  maxSeatCount     Int?
  firstBookingOnly Boolean @default(false)
  newUserOnly      Boolean @default(false)

  maxRedemptionsGlobal      Int?
  maxRedemptionsPerUser     Int?
  maxRedemptionsPerPhone    Int?
  maxDiscountPerBookingXOF  Int?
  budgetXOF                 Int?
  budgetConsumedXOF         Int     @default(0)
  budgetReservedXOF         Int     @default(0)

  stackGroup             String  @default("PROMO")
  priority               Int     @default(100)
  isAutoApply            Boolean @default(false)
  allowCombineWithCredit Boolean @default(true)
  requireOperatorOptIn   Boolean @default(false)

  createdByUserId String?
  createdBy       User?    @relation("DiscountCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  pausedByAdminAt DateTime?
  pauseReason     String?

  coupons      CouponCode[]
  vouchers     MonetaryVoucher[]
  redemptions  DiscountRedemption[]
  routeScopes  CampaignRouteScope[]
  tripScopes   CampaignTripScope[]
  scheduleScopes CampaignScheduleScope[]
  companyOptIns  CampaignCompanyOptIn[]
  referralProgramsAsWelcome ReferralProgram[] @relation("ReferralWelcomeCampaign")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([companyId])
  @@index([stackGroup])
  @@index([isAutoApply, status])
  @@index([ownerType, status])
  @@map("discount_campaign")
}

model CouponCode {
  id         String           @id @default(cuid())
  campaignId String
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  code       String           @unique
  isActive   Boolean          @default(true)

  maxRedemptions Int?
  expiresAt      DateTime?
  assignedUserId String?
  assignedUser   User?     @relation("CouponCodeAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  redemptionCount Int      @default(0)

  redemptions DiscountRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([assignedUserId])
  @@index([isActive])
  @@map("coupon_code")
}

model MonetaryVoucher {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation("MonetaryVoucherOwner", fields: [userId], references: [id], onDelete: Cascade)
  code   String?       @unique
  source VoucherSource
  status VoucherStatus @default(ACTIVE)

  originalAmountXOF  Int
  remainingAmountXOF Int
  reservedAmountXOF  Int    @default(0)
  currency           String @default("XOF")

  expiresAt                      DateTime?
  expiresOnFirstCompletedBooking Boolean @default(false)

  /** Required for CANCELLATION vouchers — redeemable only on this schedule. */
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  /** Issuing operator company (cancellation vouchers). */
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  sourceHoldGroupId String?
  sourceHoldGroup   HoldGroup? @relation("VoucherSourceHoldGroup", fields: [sourceHoldGroupId], references: [id], onDelete: SetNull)
  sourceBookingId   String?
  sourceBooking     Booking?   @relation("VoucherSourceBooking", fields: [sourceBookingId], references: [id], onDelete: SetNull)
  issuedByAdminId   String?
  issuedByAdmin     User?      @relation("MonetaryVoucherIssuedBy", fields: [issuedByAdminId], references: [id], onDelete: SetNull)
  campaignId        String?
  campaign          DiscountCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  redemptions DiscountRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
  @@index([campaignId])
  @@index([sourceHoldGroupId])
  @@index([sourceBookingId])
  @@index([scheduleId])
  @@index([companyId])
  @@map("monetary_voucher")
}

model CreditLot {
  id     String          @id @default(cuid())
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  source CreditLotSource
  status CreditLotStatus @default(ACTIVE)

  amountXOF         Int
  remainingXOF      Int
  reservedXOF       Int       @default(0)
  expiresAt         DateTime?
  /** When set and status=PENDING, cron activates the lot after this time. */
  availableAt       DateTime?
  referralEdgeId    String?
  referralEdge      ReferralEdge? @relation(fields: [referralEdgeId], references: [id], onDelete: SetNull)
  sourceBookingId   String?
  sourceHoldGroupId String?
  grantIdempotencyKey String? @unique

  redemptions DiscountRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
  @@index([referralEdgeId])
  @@index([status, availableAt])
  @@map("credit_lot")
}

model ReferralProgram {
  id       String  @id @default("default")
  isActive Boolean @default(false)

  refereeCouponCampaignId String?
  refereeCouponCampaign   DiscountCampaign? @relation("ReferralWelcomeCampaign", fields: [refereeCouponCampaignId], references: [id], onDelete: SetNull)

  referrerCreditAmountXOF  Int @default(0)
  recurringCreditAmountXOF Int @default(0)
  recurringMaxBookings     Int @default(3)
  recurringWindowDays      Int @default(180)

  requirePaidConfirmedBooking Boolean @default(true)
  rewardDelayHours            Int     @default(48)
  selfReferralBlock           Boolean @default(true)
  sameDeviceBlock             Boolean @default(true)
  samePhoneBlock              Boolean @default(true)
  maxQualificationsPerReferrerPerDay Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("referral_program")
}

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())

  edges ReferralEdge[]

  @@map("referral_code")
}

model ReferralEdge {
  id              String             @id @default(cuid())
  referrerUserId  String
  referrer        User               @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  refereeUserId   String             @unique
  referee         User               @relation("ReferralReferee", fields: [refereeUserId], references: [id], onDelete: Cascade)
  referralCodeId  String
  referralCode    ReferralCode       @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  status          ReferralEdgeStatus @default(ATTRIBUTED)

  attributedAt     DateTime @default(now())
  qualifiedAt      DateTime?
  rewardedAt       DateTime?
  firstHoldGroupId String?
  deviceHash       String?
  ipHash           String?
  fraudFlags       Json?

  creditLots CreditLot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerUserId, status])
  @@index([referralCodeId])
  @@index([status])
  @@map("referral_edge")
}

model DiscountRedemption {
  id          String                  @id @default(cuid())
  holdGroupId String
  holdGroup   HoldGroup               @relation(fields: [holdGroupId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      DiscountRedemptionStatus @default(RESERVED)

  instrumentType InstrumentType
  campaignId     String?
  campaign       DiscountCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  couponCodeId   String?
  couponCode     CouponCode?       @relation(fields: [couponCodeId], references: [id], onDelete: SetNull)
  voucherId      String?
  voucher        MonetaryVoucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  creditLotId    String?
  creditLot      CreditLot?        @relation(fields: [creditLotId], references: [id], onDelete: SetNull)

  ticketDiscountXOF Int @default(0)
  feeDiscountXOF    Int @default(0)
  creditAppliedXOF  Int @default(0)

  fundingType          CampaignFundingType?
  platformFundedXOF    Int @default(0)
  operatorFundedXOF    Int @default(0)
  companyId            String?
  company              Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  deviceHash   String?
  ipHash       String?
  snapshotJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([holdGroupId])
  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([couponCodeId])
  @@index([voucherId])
  @@map("discount_redemption")
}

model CampaignRouteScope {
  id         String           @id @default(cuid())
  campaignId String
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  routeId    String
  route      Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([campaignId, routeId])
  @@index([routeId])
  @@map("campaign_route_scope")
}

model CampaignTripScope {
  id         String           @id @default(cuid())
  campaignId String
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tripId     String
  trip       Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([campaignId, tripId])
  @@index([tripId])
  @@map("campaign_trip_scope")
}

model CampaignScheduleScope {
  id         String           @id @default(cuid())
  campaignId String
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([campaignId, scheduleId])
  @@index([scheduleId])
  @@map("campaign_schedule_scope")
}

model CampaignCompanyOptIn {
  id         String              @id @default(cuid())
  campaignId String
  campaign   DiscountCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status     CampaignOptInStatus @default(INVITED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, companyId])
  @@index([companyId])
  @@map("campaign_company_opt_in")
}

model PromoAbuseEvent {
  id        String   @id @default(cuid())
  eventType String
  userId    String?
  campaignId String?
  metadata  Json?
  reviewStatus     PromoAbuseReviewStatus @default(OPEN)
  assigneeUserId   String?
  resolutionNote   String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([userId])
  @@index([reviewStatus, createdAt])
  @@map("promo_abuse_event")
}

/// Durable Novu delivery queue (Phase 07 / D8 / P2-2).
model OutboxMessage {
  id             String             @id @default(cuid())
  /// Stable event type (e.g. BOOKING_CONFIRMED); workflowId lives in payload.
  type           String
  payload        Json
  status         OutboxMessageStatus @default(PENDING)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(8)
  nextAttemptAt  DateTime            @default(now())
  lastError      String?
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([type, createdAt])
  @@map("outbox_message")
}
