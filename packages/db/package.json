{
  "name": "@moja/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Prisma client access for Moja Buss workspaces.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "echo \"No build configured for @moja/db\"",
    "lint": "biome check package.json tsconfig.json src",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests configured for @moja/db\"",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "migrate-ledger": "tsx scripts/migrate-ledger.ts",
    "migrate:vouchers": "tsx scripts/migrate-vouchers-to-promo-credits.ts",
    "reconcile-ledger": "tsx scripts/reconcile-ledger.ts",
    "import:geo": "tsx scripts/import-ivory-coast-geo.ts",
    "convert:places": "tsx scripts/convert-populated-places.ts",
    "export:geo-seed": "tsx scripts/export-geo-seed.ts",
    "migrate:drivers": "tsx scripts/migrate-drivers-data.ts"
  },
  "dependencies": {
    "@moja/config": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.16.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@moja/typescript": "workspace:*",
    "prisma": "^7.8.0",
    "tsx": "^4.7.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
