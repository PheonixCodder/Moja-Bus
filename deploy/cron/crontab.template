# Moja Buss - production cron jobs (self-hosted replacement for Vercel crons).
# Source schedules: apps/web/vercel.json. Daily midnight jobs are staggered to
# avoid DB contention at 00:00. Each job calls the web service with the cron secret.
# __CRON_SECRET__ is substituted by entrypoint.sh at container start.
*/10 * * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/reconcile-payments
*/5 * * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/expire-holds
*/15 * * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/release-reservations
0 */6 * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/sweep-captures
10 0 * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/snapshot-accounts
15 0 * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/publish-blogs
0 1 * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/release-escrow
0 2 * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/generate-trips
20 0 * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/process-referral-rewards
0 9 * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/promo-expiry-reminders
25 0 * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/incentive-status-sweep
30 0 * * * curl -fsS -m 120 -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/process-outbox
