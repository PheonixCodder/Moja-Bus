# Moja Buss - production cron jobs.
# Source schedules: app cron handler behavior. Do not mirror apps/web/vercel.json
# here because Vercel free cron limits force once-daily schedules there.
# Jobs are staggered to reduce DB contention. Each job calls the web service with the cron secret.
# __CRON_SECRET__ is substituted by entrypoint.sh at container start.

* * * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/process-outbox
*/5 * * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/expire-holds
2-59/5 * * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/reconcile-payments
4-59/15 * * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/release-reservations
7-59/15 * * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/process-referral-rewards
8-59/15 * * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/publish-blogs
15 * * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/incentive-status-sweep
0 * * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/expire-offers
0 */6 * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/sweep-captures
0 1 * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/release-escrow
0 2 * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/generate-trips
30 2 * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/reconcile-driver-stats
15 2 * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/expire-driver-licenses
30 3 * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/snapshot-accounts
0 9 * * * curl -fsS -m 120 -o /dev/null -H "Authorization: Bearer __CRON_SECRET__" http://web:3000/api/cron/promo-expiry-reminders
