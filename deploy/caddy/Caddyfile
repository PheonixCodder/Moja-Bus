# Moja Buss — production reverse proxy (Caddy)
# SITE_ADDRESS / STATUS_ADDRESS are injected from the compose `.env`
# (e.g. mojaride.net / status.mojaride.net, or localhost for a local smoke
# test). Caddy auto-provisions Let's Encrypt certificates for public domains
# and uses its internal CA for `localhost`.

{$SITE_ADDRESS} {
	encode zstd gzip

	reverse_proxy web:3000 {
		transport http {
			versions 1.1 2
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Phase 35 (F-IN-10) — the platform-wide kill-switch
		# ("geolocation=(), microphone=(), camera=()") silently broke browser
		# geolocation capture AND the operator QR ticket scanner (camera).
		# Allow self for the features the product actually uses; microphone
		# stays denied. Status/PostHog/SigNoz blocks are untouched below.
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		# Phase 35 (D35-4) & Phase 6 — REPORT-ONLY baseline. Builds a violation record so
		# enforcement (flipping to Content-Security-Policy) is evidence-driven,
		# not blind. Sources include wss:// for real-time telemetry gateway.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.mojaride.com https://{$S3_PUBLIC_HOST:cdn.mojaride.com} https://tile.openstreetmap.org https://lh3.googleusercontent.com https://avatar.vercel.sh; connect-src 'self' ws://{$SITE_ADDRESS} wss://{$SITE_ADDRESS} {$POSTHOG_PUBLIC_HOST:https://us.i.posthog.com}; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	}

	log {
		output stdout
		format json
	}
}

# Uptime Kuma status page (public subdomain — password-protected dashboard).
{$STATUS_ADDRESS} {
	encode zstd gzip

	reverse_proxy status:3001

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	log {
		output stdout
		format json
	}
}

# Self-hosted PostHog (separate compose project in deploy/posthog/). Its web
# app listens on 127.0.0.1:8000 on the host; PostHog's own Caddy is disabled.
# host.docker.internal is mapped to the host gateway in compose.yml (extra_hosts).
{$POSTHOG_ADDRESS} {
	encode zstd gzip

	reverse_proxy host.docker.internal:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	log {
		output stdout
		format json
	}
}

# Self-hosted SigNoz (separate compose project in deploy/signoz/, installed via
# Foundry). The SigNoz UI/API listens on 127.0.0.1:8080 on the host. OTLP traces
# go straight from web to the ingester on host.docker.internal:4318 (see
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT in the compose .env).
{$SIGNOZ_ADDRESS} {
	encode zstd gzip

	reverse_proxy host.docker.internal:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	log {
		output stdout
		format json
	}
}
