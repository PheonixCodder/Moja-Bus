# Moja Driver App — environment template (P2-14)
# Copy to .env and fill in. All vars are build-time inlined by Expo.

# Backend API base URL (tRPC + telemetry HTTP ingest)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Telemetry transport — Phase 09 Option B: v1 is HTTP-only via EXPO_PUBLIC_API_URL.
# The WS gateway is DORMANT in production. Leave UNSET; the client skips WS
# entirely and drains its offline queue over HTTP. Set this ONLY when the
# live-tracking consumer ships and a hosted gateway exists (see
# server/telemetry-ws.ts revival checklist):
# EXPO_PUBLIC_WS_URL=wss://your-host/api/ws/telemetry

# Mapbox public token — REQUIRED for maps in production builds
# https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=
