# Moja Traveler App — environment template (P2-14)
# Copy to .env and fill in. All vars are build-time inlined by Expo.

# Backend API base URL (tRPC)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Mapbox public token — REQUIRED for maps in production builds
# https://account.mapbox.com/account/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=

# PostHog analytics — optional; omit to disable
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Live bus tracking entry point — Phase 18 ships this OFF until a real
# telemetry consumer exists. Set to "true" only after the WS consumer ships.
EXPO_PUBLIC_LIVE_TRACKING_ENABLED=false

# Web app URL used for cross-links (referrals) — optional
# EXPO_PUBLIC_WEB_URL=

# NOVU — Phase 36 (F-IN-11) ruling: there is intentionally NO Novu
# application-identifier env var in either mobile app. The identifier and the
# subscriber HMAC arrive at runtime from the backend
# (`public.getNotificationToken`), so adding an EXPO_PUBLIC_NOVU_* var here
# would be a phantom. Server side: NEXT_PUBLIC_NOVU_APP_ID in apps/web.
