{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "PAYSTACK_SECRET_KEY",
    "NOVU_SECRET_KEY",
    "CRON_SECRET",
    "CHECKOUT_QUOTE_SECRET",
    "TELEMETRY_TOKEN_SECRET",
    "BANK_ENCRYPTION_KEY",
    "BANK_ENCRYPTION_KEY_PREVIOUS",
    "BETTER_AUTH_URL",
    "APP_URL",
    "ALLOWED_ORIGINS",
    "NEXT_PUBLIC_APP_URL",
    "WITHDRAWAL_2FA_PEPPER",
    "GOOGLE_WEB_CLIENT_ID",
    "GOOGLE_IOS_CLIENT_ID",
    "GOOGLE_ANDROID_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_BUCKET",
    "S3_PUBLIC_URL_BASE",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY",
    "NEXT_PUBLIC_PAYSTACK_CHECKOUT_MODE",
    "NEXT_PUBLIC_NOVU_APP_ID"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "clean": {
      "cache": false
    }
  }
}
