# ============================================================================
# Moja Buss — Docker Compose environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` at the repo root and fill in real values, then:
#     docker compose up -d --build
# `.env` is gitignored — NEVER commit real values.
#
# Generate secrets with:
#     openssl rand -base64 32   # BETTER_AUTH_SECRET, CRON_SECRET
#     openssl rand -hex 32      # BANK_ENCRYPTION_KEY
#
# Production domain: mojaride.net (DNS must point at the server). For a local
# smoke test set SITE_ADDRESS=localhost (Caddy uses its internal CA; curl -k).
# ============================================================================

# --- Routing / TLS ----------------------------------------------------------
SITE_ADDRESS=mojaride.net
# Uptime Kuma status page — add a DNS A record for this subdomain pointing at
# the server. Local smoke test: status.localhost.
STATUS_ADDRESS=status.mojaride.net
# Self-hosted PostHog — add a DNS A record for this subdomain. PostHog runs as
# a SEPARATE compose project (deploy/posthog/) publishing 127.0.0.1:8000; our
# Caddy fronts it. Leave unset if not deployed.
POSTHOG_ADDRESS=posthog.mojaride.net

# Self-hosted SigNoz — add a DNS A record for this subdomain. SigNoz runs as a
# SEPARATE compose project (deploy/signoz/, installed via Foundry) publishing
# its UI on 127.0.0.1:8080; our Caddy fronts it. Leave unset if not deployed.
SIGNOZ_ADDRESS=signoz.mojaride.net

# OpenTelemetry — web server traces to the SigNoz ingester (separate project).
# OTLP HTTP (protobuf) to the host gateway:4318; empty locally = no tracing.
OTEL_SERVICE_NAME=moja-buss-web
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
# Optional: per-build version for SigNoz deployment markers, e.g.
# OTEL_RESOURCE_ATTRIBUTES=service.version=1.4.2

# --- Canonical origins (auth callbacks, emails, payment returns) -------------
# All three must be the same public origin.
BETTER_AUTH_URL=https://mojaride.net
APP_URL=https://mojaride.net
ALLOWED_ORIGINS=https://mojaride.net
NEXT_PUBLIC_APP_URL=https://mojaride.net

# --- Database ---------------------------------------------------------------
# Self-hosted Postgres (postgres:16-alpine, compose service `db`). The app's
# DATABASE_URL is derived in compose.yml as
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}.
POSTGRES_USER=moja
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=moja
# Keep the last N daily backups (rotated by the `backup` service).
BACKUP_RETENTION_DAYS=7

# Build-time DB only: `next build` prerenders routes that touch the DB, and the
# `db` container isn't up during `docker compose build`. Point this at any
# reachable PostgreSQL. Runtime always uses the self-hosted `db` service.
DATABASE_URL_BUILD=postgresql://user:password@host:5432/moja?sslmode=require

# --- Auth -------------------------------------------------------------------
BETTER_AUTH_SECRET=
WITHDRAWAL_2FA_PEPPER=

# Google OAuth — optional; omit all four to disable Google login.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments ---------------------------------------------------------------
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_CHECKOUT_MODE=inline

# --- Notifications (Novu) ---------------------------------------------------
NOVU_SECRET_KEY=
NEXT_PUBLIC_NOVU_APP_ID=

# --- Cron -------------------------------------------------------------------
# Protects /api/cron/*. Must match between the web and cron containers.
CRON_SECRET=
CHECKOUT_QUOTE_SECRET=

# --- Telemetry ingest (Phase 16) ---------------------------------------------
# Optional: signs short-lived driver dispatch tokens for WS/HTTP telemetry.
# Falls back to BETTER_AUTH_SECRET when unset; production requires one of them.
TELEMETRY_TOKEN_SECRET=

# --- Bank at-rest encryption -------------------------------------------------
BANK_ENCRYPTION_KEY=
BANK_ENCRYPTION_KEY_PREVIOUS=

# --- Storage (S3 / Cloudflare R2) --------------------------------------------
# If all S3_* are omitted the app falls back to local disk storage.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL_BASE=

# --- Public (inlined at build; also needed at runtime for server-side reads) -
NEXT_PUBLIC_APP_NAME=Moja Ride
NEXT_PUBLIC_POSTHOG_KEY=phc_zJL24rdHaATKXTUd3jw65SxaZtTkqdd3i49N6H7jSz2q
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
